# Copiar a `.env` (sin .example) y completar. El .env esta en .gitignore: el
# token de abajo es un secreto y no va al repo.

# --- OBLIGATORIA ---
#
# El token con el que el nodo se autentica para publicar lecturas. Va tambien
# en el firmware (include/config.local.h), como header:
#
#     Authorization: Bearer <este valor>
#
# Generar uno con:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# La API se niega a arrancar si esto falta, y no tiene valor por default a
# proposito: un default (aunque sea "cambiame") deja el endpoint de escritura
# abierto mientras todo parece andar bien. Cualquiera que encuentre la URL
# podria inyectar un nivel inventado, y un numero falso es peor que ningun
# numero porque nadie va a ir a mirar el tanque.
AMARTYA_TOKEN_NODO=

# --- OPCIONALES (los defaults sirven) ---

# Puerto en el que queda la interfaz cuando se levanta con Docker.
#
# 8090 y no 8080 porque el proyecto hermano Casa Rosada corre en la misma
# maquina y su compose ya publica el dashboard en 8080 (ademas de 3000 para
# Grafana, 8086 para InfluxDB y 1883/9001 para Mosquitto). Con los dos stacks
# arriba, el segundo falla con un "port is already allocated" que no aclara de
# quien es el puerto.
#AMARTYA_PUERTO_WEB=8090

# Si hay un proxy adelante que setea X-Real-IP. El docker-compose lo pone en
# true porque ahi nginx cumple las dos condiciones que lo hacen seguro:
# sobrescribe el header, y la API no es alcanzable por ningun otro lado.
#
# NO ponerlo en true si la API queda expuesta directo: el header lo puede
# mandar cualquiera, y creyendole se saltea el limite de tasa cambiandolo en
# cada request.
#AMARTYA_DETRAS_DE_PROXY=false

# Donde vive el archivo SQLite. En Docker lo pone el compose apuntando al
# volumen; esto es para correr sin contenedores.
#AMARTYA_DB=datos/amartya.db

# POST por minuto y por IP antes de devolver 429. El nodo publica cada 15
# minutos, asi que 6 ya es sesenta veces lo normal.
#
# OJO: el contador es en memoria y cada worker de gunicorn lleva el suyo, asi
# que en Docker el limite efectivo es este numero POR LA CANTIDAD DE WORKERS.
# Medido con los 2 del Dockerfile: con esto en 6, la API acepta 12 por minuto.
#
# Para sembrar datos de prueba con tools/sembrar.py hay que subirlo mucho
# (AMARTYA_MAX_POST_POR_MINUTO=100000) y volverlo a bajar despues.
#AMARTYA_MAX_POST_POR_MINUTO=6

# Tope de puntos que devuelve /historico antes de promediar en cubetas. 700
# esta elegido para que la ventana mas grande de la interfaz —7 dias a una
# lectura cada 15 minutos, 672 puntos— pase entera y sin tocar.
#AMARTYA_MAX_PUNTOS=700

# Ventana maxima que se puede pedir a /historico, en horas. Un ano.
#AMARTYA_MAX_HORAS=8760
