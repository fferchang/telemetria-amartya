# Secretos y config del entorno. NUNCA se suben.
# Ojo: ui/config.js SÍ va al repo — no tiene secretos y sin él la página no
# arranca (ver la cabecera de ese archivo). El .env de acá es para el backend,
# que sí los va a tener.
.env
.env.*
!.env.example

# Firmware (PlatformIO), cuando se agregue
.pio/
include/config.local.h

# Python del backend/tools
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/

# La base de datos. En produccion vive en un volumen de Docker; esto es la
# copia local de desarrollo, con lecturas sembradas de prueba. Subirla seria
# subir datos inventados que despues alguien puede confundir con reales.
datos/
*.db
*.db-wal
*.db-shm

# Sistema operativo y editores
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
